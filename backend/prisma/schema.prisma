generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum RolUsuario {
  ADMINISTRADOR
  MEDICO
  ENFERMERO
  AUXILIAR_ENFERMERIA
  RECEPCION_ADMISIONES
  REGENTE_FARMACIA
  AUXILIAR_FARMACIA
  QUIMICO_FARMACEUTICO
}

enum EstadoFormulacion {
  VIGENTE
  VENCIDA
  CANCELADA
}

enum TipoDiagnostico {
  AGUDO
  CRONICO
  OTRO
}

enum EstadoEsquemaTratamiento {
  ACTIVO
  INACTIVO
  SUSPENDIDO
  FINALIZADO
}

enum EstadoProductoInventario {
  ACTIVO
  INACTIVO
}

enum EstadoLoteInventario {
  DISPONIBLE
  AGOTADO
  VENCIDO
  BLOQUEADO
}

enum TipoProductoInventario {
  MEDICAMENTO
  INSUMO
  DISPOSITIVO_MEDICO
}

enum CondicionConservacion {
  AMBIENTE
  CADENA_FRIO
  OTRA
}

enum TipoBodega {
  GENERAL
  SATELITE
  NO_CONFORMES
}

enum EstadoVerificacionInvima {
  PENDIENTE
  VIGENTE
  NO_VIGENTE
  NO_APLICA
}

enum ResultadoVerificacionIngreso {
  PENDIENTE
  CONFORME
  NO_CONFORME
}

enum EstadoActaRecepcion {
  BORRADOR
  PENDIENTE_REVISION
  APROBADA
  RECHAZADA
  ANULADA
}

enum EstadoGestionNoConforme {
  PENDIENTE
  EN_CUSTODIA
  DEVUELTO_PROVEEDOR
  REINTEGRADO
}

enum OrigenGestionNoConforme {
  RECEPCION
  ALMACENAMIENTO
  VENCIMIENTO
}

enum TipoDisposicionNoConforme {
  DEVOLUCION_PROVEEDOR
  CAMBIO_FISICO
}

enum EstadoIngresoInventario {
  BORRADOR
  CONFIRMADO
  ANULADO
}

enum TipoMovimientoInventario {
  INGRESO
  TRASLADO
  AJUSTE_ENTRADA
  AJUSTE_SALIDA
  DISPENSACION
  DEVOLUCION_PROVEEDOR
}

enum EstadoDispensacion {
  PENDIENTE
  CONFIRMADA
  ANULADA
}

enum TipoFirmaDispensacion {
  DIGITAL
  MANUAL
}

enum TipoCambioVerificacionRecepcion {
  REEVALUACION
  CORRECCION_DOCUMENTAL
}

model Servicio {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios Usuario[]

  @@map("servicios")
}

model Usuario {
  id               Int        @id @default(autoincrement())
  nombre           String
  correo           String     @unique
  password         String
  rol              RolUsuario @default(AUXILIAR_FARMACIA)
  activo           Boolean    @default(true)
  intentosFallidos Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  servicioId       Int?
  esCoordinador    Boolean    @default(false)

  servicio Servicio? @relation(fields: [servicioId], references: [id], onDelete: Restrict)

  atencionesClinicas AtencionClinica[]

  bodegasCreadas Bodega[] @relation("BodegaCreadaPor")

  actasRecepcionElaboradas ActaRecepcion[] @relation("ActaElaboradaPor")
  actasRecepcionRevisadas  ActaRecepcion[] @relation("ActaRevisadaPor")

  ingresosInventario IngresoInventario[] @relation("IngresoConfirmadoPor")

  movimientosInventario          MovimientoInventario[]
  documentosInventario           DocumentoInventario[]                 @relation("DocumentoInventarioCreadoPor")
  documentosMovimientoInventario DocumentoMovimientoInventario[]       @relation("DocumentoMovimientoInventarioRegistradoPor")
  documentosActaRecepcion        DocumentoActaRecepcion[]              @relation("DocumentoActaRecepcionRegistradoPor")
  documentosCorreccionRecepcion  DocumentoCorreccionDetalleRecepcion[] @relation("DocumentoCorreccionDetalleRecepcionRegistradoPor")

  recuperacionesPassword RecuperacionPassword[]

  dispensaciones         Dispensacion[]          @relation("DispensacionRealizadaPor")
  documentosDispensacion DocumentoDispensacion[]
  soportesDispensacion   SoporteDispensacion[]

  gestionesNoConformes   GestionNoConforme[]
  reevaluacionesTecnicas ReevaluacionTecnicaRecepcion[]

  correccionesRecepcion CorreccionDetalleRecepcion[]

  @@index([servicioId])
  @@map("usuarios")
}

model Paciente {
  id              Int      @id @default(autoincrement())
  tipoDocumento   String
  numeroDocumento String   @unique
  nombres         String
  apellidos       String
  fechaNacimiento DateTime
  telefono        String?
  correo          String?
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  historiaClinica HistoriaClinica?

  dispensaciones Dispensacion[]

  @@map("pacientes")
}

model HistoriaClinica {
  id             Int      @id @default(autoincrement())
  pacienteId     Int      @unique
  grupoSanguineo String?
  alergias       String?
  antecedentes   String?
  diagnosticos   String?
  observaciones  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  atenciones AtencionClinica[]

  diagnosticosPaciente DiagnosticoPaciente[]

  @@map("historias_clinicas")
}

model AtencionClinica {
  id                Int      @id @default(autoincrement())
  historiaClinicaId Int
  profesionalId     Int
  numeroIngreso     String   @unique
  fechaAtencion     DateTime @default(now())
  motivoConsulta    String?
  evolucion         String?
  diagnostico       String?
  observaciones     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  historiaClinica HistoriaClinica @relation(fields: [historiaClinicaId], references: [id], onDelete: Cascade)

  profesional Usuario @relation(fields: [profesionalId], references: [id])

  formulaciones Formulacion[]

  diagnosticosPaciente DiagnosticoPaciente[]

  @@map("atenciones_clinicas")
}

model DiagnosticoPaciente {
  id                Int             @id @default(autoincrement())
  historiaClinicaId Int
  atencionClinicaId Int?
  nombre            String
  codigoCie10       String?
  tipo              TipoDiagnostico
  requiereEsquema   Boolean         @default(false)
  fechaDiagnostico  DateTime        @default(now())
  activo            Boolean         @default(true)
  observaciones     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  historiaClinica HistoriaClinica @relation(fields: [historiaClinicaId], references: [id], onDelete: Cascade)

  atencionClinica AtencionClinica? @relation(fields: [atencionClinicaId], references: [id])

  esquemas EsquemaTratamiento[]

  formulaciones Formulacion[]

  @@map("diagnosticos_paciente")
}

model EsquemaTratamiento {
  id                    Int                      @id @default(autoincrement())
  diagnosticoPacienteId Int
  fechaInicio           DateTime                 @default(now())
  fechaFin              DateTime?
  estado                EstadoEsquemaTratamiento @default(ACTIVO)
  observaciones         String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  diagnosticoPaciente DiagnosticoPaciente @relation(fields: [diagnosticoPacienteId], references: [id], onDelete: Cascade)

  medicamentos DetalleEsquemaTratamiento[]

  @@map("esquemas_tratamiento")
}

model DetalleEsquemaTratamiento {
  id                Int     @id @default(autoincrement())
  esquemaId         Int
  medicamento       String
  concentracion     String?
  formaFarmaceutica String?
  dosis             String
  frecuencia        String
  viaAdministracion String?
  observaciones     String?

  esquema EsquemaTratamiento @relation(fields: [esquemaId], references: [id], onDelete: Cascade)

  @@map("detalles_esquema_tratamiento")
}

model Formulacion {
  id                    Int               @id @default(autoincrement())
  atencionClinicaId     Int
  diagnosticoPacienteId Int?
  fechaFormulacion      DateTime          @default(now())
  vigenciaMeses         Int               @default(1)
  indicaciones          String?
  estado                EstadoFormulacion @default(VIGENTE)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  atencionClinica AtencionClinica @relation(fields: [atencionClinicaId], references: [id], onDelete: Cascade)

  diagnosticoPaciente DiagnosticoPaciente? @relation(fields: [diagnosticoPacienteId], references: [id])

  medicamentos DetalleFormulacion[]

  @@map("formulaciones")
}

model DetalleFormulacion {
  id                Int     @id @default(autoincrement())
  formulacionId     Int
  medicamento       String
  concentracion     String?
  formaFarmaceutica String?
  dosis             String
  frecuencia        String
  duracion          String?
  cantidad          Int
  viaAdministracion String?
  observaciones     String?

  formulacion Formulacion @relation(fields: [formulacionId], references: [id], onDelete: Cascade)

  detallesDispensacion DetalleDispensacion[]

  @@map("detalles_formulacion")
}

model Medicamento {
  id                Int      @id @default(autoincrement())
  nombre            String
  concentracion     String
  formaFarmaceutica String
  viaAdministracion String?
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productos ProductoInventario[]

  @@unique([nombre, concentracion, formaFarmaceutica])
  @@map("medicamentos")
}

model ProductoInventario {
  id             Int                    @id @default(autoincrement())
  medicamentoId  Int?
  codigoInterno  Int?                   @unique
  codigoBarras   String?                @unique
  tipo           TipoProductoInventario
  descripcion    String
  marca          String?
  laboratorio    String?
  registroInvima String?

  condicionConservacion CondicionConservacion @default(AMBIENTE)
  temperaturaMinima     Float?
  temperaturaMaxima     Float?
  humedadMaxima         Float?
  claseRiesgo           String?

  estado    EstadoProductoInventario @default(ACTIVO)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  medicamento Medicamento? @relation(fields: [medicamentoId], references: [id])

  lotes LoteInventario[]

  detallesActaRecepcion DetalleActaRecepcion[]

  @@map("productos_inventario")
}

model LoteInventario {
  id                   Int      @id @default(autoincrement())
  productoInventarioId Int
  numeroLote           String
  fechaVencimiento     DateTime

  // Temporal: HU-017 y HU-018 todavía utilizan este campo.
  // El stock definitivo será controlado por ExistenciaInventario.
  cantidad Int @default(0)

  estado    EstadoLoteInventario @default(DISPONIBLE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  productoInventario ProductoInventario @relation(fields: [productoInventarioId], references: [id], onDelete: Cascade)

  existencias ExistenciaInventario[]

  detallesIngreso DetalleIngresoInventario[]

  movimientos MovimientoInventario[]

  detallesDispensacion DetalleDispensacion[]

  gestionesNoConformes GestionNoConforme[]

  @@unique([productoInventarioId, numeroLote])
  @@map("lotes_inventario")
}

model Sede {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  nombre    String
  direccion String?
  ciudad    String?
  telefono  String?
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bodegas Bodega[]

  actasRecepcion ActaRecepcion[]

  @@map("sedes")
}

model Bodega {
  id                  Int        @id @default(autoincrement())
  sedeId              Int
  codigo              String?    @unique
  nombre              String
  tipo                TipoBodega @default(GENERAL)
  descripcion         String?
  permiteDispensacion Boolean    @default(false)
  activa              Boolean    @default(true)
  creadoPorId         Int?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  sede Sede @relation(fields: [sedeId], references: [id])

  creadoPor Usuario? @relation("BodegaCreadaPor", fields: [creadoPorId], references: [id])

  existencias ExistenciaInventario[]

  ingresosDestino IngresoInventario[]

  actasRecepcionDestino ActaRecepcion[] @relation("ActaBodegaDestino")

  movimientosOrigen MovimientoInventario[] @relation("MovimientoBodegaOrigen")

  movimientosDestino MovimientoInventario[] @relation("MovimientoBodegaDestino")

  dispensaciones Dispensacion[]

  gestionesNoConformes GestionNoConforme[] @relation("GestionBodegaCustodia")

  gestionesNoConformesOrigen GestionNoConforme[] @relation("GestionBodegaOrigen")

  @@unique([sedeId, nombre])
  @@index([sedeId])
  @@map("bodegas")
}

model Proveedor {
  id              Int      @id @default(autoincrement())
  nit             String   @unique
  razonSocial     String
  nombreComercial String?
  telefono        String?
  correo          String?
  direccion       String?
  contacto        String?
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  actasRecepcion ActaRecepcion[]

  @@map("proveedores")
}

model ActaRecepcion {
  id                Int                 @id @default(autoincrement())
  numeroActa        String              @unique
  sedeId            Int
  bodegaDestinoId   Int?
  proveedorId       Int
  elaboradoPorId    Int
  revisadoPorId     Int?
  numeroFactura     String?
  numeroOrdenCompra String?
  numeroRemision    String?
  fechaFactura      DateTime?
  fechaRecepcion    DateTime            @default(now())
  estado            EstadoActaRecepcion @default(BORRADOR)
  observaciones     String?
  fechaRevision     DateTime?
  motivoRechazo     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  sede Sede @relation(fields: [sedeId], references: [id])

  bodegaDestino Bodega? @relation("ActaBodegaDestino", fields: [bodegaDestinoId], references: [id])

  proveedor Proveedor @relation(fields: [proveedorId], references: [id])

  elaboradoPor Usuario @relation("ActaElaboradaPor", fields: [elaboradoPorId], references: [id])

  revisadoPor Usuario? @relation("ActaRevisadaPor", fields: [revisadoPorId], references: [id])

  detalles DetalleActaRecepcion[]

  ingresoInventario IngresoInventario?

  documentos DocumentoActaRecepcion[]

  @@index([sedeId])
  @@index([bodegaDestinoId])
  @@index([proveedorId])
  @@index([elaboradoPorId])
  @@index([revisadoPorId])
  @@map("actas_recepcion")
}

model DetalleActaRecepcion {
  id               Int      @id @default(autoincrement())
  actaRecepcionId  Int
  productoId       Int
  numeroLote       String
  fechaVencimiento DateTime
  cantidadRecibida Int
  registroInvima   String?

  estadoVerificacionInvima EstadoVerificacionInvima     @default(PENDIENTE)
  temperaturaRegistrada    Float?
  humedadRegistrada        Float?
  resultadoVerificacion    ResultadoVerificacionIngreso @default(PENDIENTE)

  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  actaRecepcion ActaRecepcion @relation(fields: [actaRecepcionId], references: [id], onDelete: Cascade)

  producto ProductoInventario @relation(fields: [productoId], references: [id])

  detalleIngreso DetalleIngresoInventario?

  gestionNoConforme      GestionNoConforme?
  reevaluacionesTecnicas ReevaluacionTecnicaRecepcion[]

  correcciones CorreccionDetalleRecepcion[]

  @@index([actaRecepcionId])
  @@index([productoId])
  @@map("detalles_acta_recepcion")
}

model GestionNoConforme {
  id                     Int                        @id @default(autoincrement())
  detalleActaRecepcionId Int?                       @unique
  loteId                 Int?
  bodegaOrigenId         Int?
  bodegaId               Int?
  cantidad               Int
  origen                 OrigenGestionNoConforme    @default(RECEPCION)
  estado                 EstadoGestionNoConforme    @default(PENDIENTE)
  motivo                 String?
  disposicion            TipoDisposicionNoConforme?
  observaciones          String?
  fechaIngresoCustodia   DateTime?
  fechaCierre            DateTime?
  responsableId          Int?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  detalleActaRecepcion DetalleActaRecepcion? @relation(fields: [detalleActaRecepcionId], references: [id])

  lote LoteInventario? @relation(fields: [loteId], references: [id])

  bodegaOrigen Bodega? @relation("GestionBodegaOrigen", fields: [bodegaOrigenId], references: [id])

  bodega Bodega? @relation("GestionBodegaCustodia", fields: [bodegaId], references: [id])

  responsable Usuario? @relation(fields: [responsableId], references: [id])

  @@index([loteId])
  @@index([bodegaOrigenId])
  @@index([bodegaId])
  @@index([estado])
  @@index([origen])
  @@map("gestiones_no_conformes")
}

model IngresoInventario {
  id              Int                     @id @default(autoincrement())
  numeroIngreso   String                  @unique
  actaRecepcionId Int                     @unique
  bodegaDestinoId Int
  confirmadoPorId Int
  fechaIngreso    DateTime                @default(now())
  estado          EstadoIngresoInventario @default(BORRADOR)
  observaciones   String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  actaRecepcion ActaRecepcion @relation(fields: [actaRecepcionId], references: [id])

  bodegaDestino Bodega @relation(fields: [bodegaDestinoId], references: [id])

  confirmadoPor Usuario @relation("IngresoConfirmadoPor", fields: [confirmadoPorId], references: [id])

  detalles DetalleIngresoInventario[]

  movimientos MovimientoInventario[]

  @@index([bodegaDestinoId])
  @@index([confirmadoPorId])
  @@map("ingresos_inventario")
}

model DetalleIngresoInventario {
  id                     Int      @id @default(autoincrement())
  ingresoInventarioId    Int
  detalleActaRecepcionId Int      @unique
  loteId                 Int
  cantidadIngresada      Int
  costoUnitario          Decimal? @db.Decimal(12, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  ingresoInventario IngresoInventario @relation(fields: [ingresoInventarioId], references: [id], onDelete: Cascade)

  detalleActaRecepcion DetalleActaRecepcion @relation(fields: [detalleActaRecepcionId], references: [id])

  lote LoteInventario @relation(fields: [loteId], references: [id])

  @@index([ingresoInventarioId])
  @@index([loteId])
  @@map("detalles_ingreso_inventario")
}

model ExistenciaInventario {
  id        Int      @id @default(autoincrement())
  loteId    Int
  bodegaId  Int
  cantidad  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lote LoteInventario @relation(fields: [loteId], references: [id], onDelete: Cascade)

  bodega Bodega @relation(fields: [bodegaId], references: [id])

  @@unique([loteId, bodegaId])
  @@index([bodegaId])
  @@map("existencias_inventario")
}

model MovimientoInventario {
  id                  Int                      @id @default(autoincrement())
  loteId              Int
  tipo                TipoMovimientoInventario
  cantidad            Int
  bodegaOrigenId      Int?
  bodegaDestinoId     Int?
  usuarioId           Int
  ingresoInventarioId Int?
  dispensacionId      Int?
  motivo              String?
  referencia          String?
  fechaMovimiento     DateTime                 @default(now())
  createdAt           DateTime                 @default(now())

  lote LoteInventario @relation(fields: [loteId], references: [id])

  bodegaOrigen Bodega? @relation("MovimientoBodegaOrigen", fields: [bodegaOrigenId], references: [id])

  bodegaDestino Bodega? @relation("MovimientoBodegaDestino", fields: [bodegaDestinoId], references: [id])

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  ingresoInventario IngresoInventario? @relation(fields: [ingresoInventarioId], references: [id])

  dispensacion Dispensacion? @relation(fields: [dispensacionId], references: [id])

  documentos DocumentoMovimientoInventario[]

  @@index([loteId])
  @@index([bodegaOrigenId])
  @@index([bodegaDestinoId])
  @@index([usuarioId])
  @@index([ingresoInventarioId])
  @@index([dispensacionId])
  @@map("movimientos_inventario")
}

// Archivos privados del módulo de inventario. El contenido se guarda fuera de
// la carpeta pública; aquí solo permanecen metadatos e integridad.
model DocumentoInventario {
  id                  Int      @id @default(autoincrement())
  claveAlmacenamiento String   @unique(map: "documentos_inventario_claveAlmacenamiento_key") @db.VarChar(80)
  sha256              String   @db.Char(64)
  mime                String   @db.VarChar(64)
  tamano              Int
  creadoAt            DateTime @default(now())
  creadoPorId         Int
  versionPlantilla    String?  @db.VarChar(32)

  creadoPor    Usuario                               @relation("DocumentoInventarioCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict, map: "documentos_inventario_creadoPorId_fkey")
  movimientos  DocumentoMovimientoInventario[]
  actas        DocumentoActaRecepcion[]
  correcciones DocumentoCorreccionDetalleRecepcion[]

  @@index([creadoPorId], map: "documentos_inventario_creadoPorId_idx")
  @@map("documentos_inventario")
}

// Versiones inmutables de comprobantes y anexos de cada movimiento.
model DocumentoMovimientoInventario {
  id                     Int      @id @default(autoincrement())
  movimientoInventarioId Int
  documentoInventarioId  Int
  proposito              String   @db.VarChar(32)
  version                Int      @default(1)
  datosComprobante       Json?
  motivoCorreccion       String?  @db.Text
  registradoAt           DateTime @default(now())
  registradoPorId        Int

  movimientoInventario MovimientoInventario @relation(fields: [movimientoInventarioId], references: [id], onDelete: Restrict, map: "fk_dmi_movimiento")
  documentoInventario  DocumentoInventario  @relation(fields: [documentoInventarioId], references: [id], onDelete: Restrict, map: "fk_dmi_documento")
  registradoPor        Usuario              @relation("DocumentoMovimientoInventarioRegistradoPor", fields: [registradoPorId], references: [id], onDelete: Restrict, map: "fk_dmi_registrado")

  @@unique([movimientoInventarioId, proposito, version], map: "uq_dmi_mov_prop_ver")
  @@index([movimientoInventarioId, proposito], map: "idx_dmi_mov_prop")
  @@index([documentoInventarioId], map: "idx_dmi_documento")
  @@index([registradoPorId], map: "idx_dmi_registrado")
  @@map("documentos_movimiento_inventario")
}

// Facturas y anexos de recepción; las versiones no sustituyen el original.
model DocumentoActaRecepcion {
  id                    Int      @id @default(autoincrement())
  actaRecepcionId       Int
  documentoInventarioId Int
  proposito             String   @db.VarChar(32)
  version               Int      @default(1)
  registradoAt          DateTime @default(now())
  registradoPorId       Int

  actaRecepcion       ActaRecepcion       @relation(fields: [actaRecepcionId], references: [id], onDelete: Restrict, map: "fk_dar_acta")
  documentoInventario DocumentoInventario @relation(fields: [documentoInventarioId], references: [id], onDelete: Restrict, map: "fk_dar_documento")
  registradoPor       Usuario             @relation("DocumentoActaRecepcionRegistradoPor", fields: [registradoPorId], references: [id], onDelete: Restrict, map: "fk_dar_registrado")

  @@unique([actaRecepcionId, proposito, version], map: "uq_dar_act_prop_ver")
  @@index([actaRecepcionId, proposito], map: "idx_dar_act_prop")
  @@index([documentoInventarioId], map: "idx_dar_documento")
  @@index([registradoPorId], map: "idx_dar_registrado")
  @@map("documentos_acta_recepcion")
}

// Soportes privados y versionados de una corrección concreta. No sustituye la
// referencia textual de la corrección ni modifica documentos históricos.
model DocumentoCorreccionDetalleRecepcion {
  id                           Int      @id @default(autoincrement())
  correccionDetalleRecepcionId Int
  documentoInventarioId        Int
  proposito                    String   @db.VarChar(32)
  version                      Int      @default(1)
  registradoAt                 DateTime @default(now())
  registradoPorId              Int

  correccionDetalleRecepcion CorreccionDetalleRecepcion @relation(fields: [correccionDetalleRecepcionId], references: [id], onDelete: Restrict, map: "fk_dcr_corr")
  documentoInventario        DocumentoInventario        @relation(fields: [documentoInventarioId], references: [id], onDelete: Restrict, map: "fk_dcr_doc")
  registradoPor              Usuario                    @relation("DocumentoCorreccionDetalleRecepcionRegistradoPor", fields: [registradoPorId], references: [id], onDelete: Restrict, map: "fk_dcr_reg")

  @@unique([correccionDetalleRecepcionId, proposito, version], map: "uq_dcr_corr_prop_ver")
  @@index([correccionDetalleRecepcionId, proposito], map: "idx_dcr_corr_prop")
  @@index([documentoInventarioId], map: "idx_dcr_doc")
  @@index([registradoPorId], map: "idx_dcr_reg")
  @@map("documentos_correccion_detalle_recepcion")
}

model Dispensacion {
  claveIdempotencia  String?                 @unique @db.VarChar(64)
  hashSolicitud      String?                 @db.Char(64)
  datosComprobante   Json?
  versionDocumental  Int                     @default(0)
  documentos         DocumentoDispensacion[]
  soportes           SoporteDispensacion[]
  id                 Int                     @id @default(autoincrement())
  numeroDispensacion String                  @unique
  pacienteId         Int
  bodegaId           Int
  dispensadoPorId    Int
  periodoAnio        Int
  periodoMes         Int
  fechaDispensacion  DateTime                @default(now())
  estado             EstadoDispensacion      @default(PENDIENTE)
  observaciones      String?

  numeroComprobante String?   @unique
  fechaComprobante  DateTime?

  tipoFirma         TipoFirmaDispensacion?
  firmaPaciente     String?
  soporteFirmado    String?
  fechaFirma        DateTime?
  fechaCargaSoporte DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paciente Paciente @relation(fields: [pacienteId], references: [id])

  bodega Bodega @relation(fields: [bodegaId], references: [id])

  dispensadoPor Usuario @relation("DispensacionRealizadaPor", fields: [dispensadoPorId], references: [id])

  detalles DetalleDispensacion[]

  movimientos MovimientoInventario[]

  @@index([pacienteId])
  @@index([bodegaId])
  @@index([dispensadoPorId])
  @@index([periodoAnio, periodoMes])
  @@map("dispensaciones")
}

model DetalleDispensacion {
  id                   Int      @id @default(autoincrement())
  dispensacionId       Int
  detalleFormulacionId Int
  loteId               Int
  cantidadEntregada    Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  dispensacion Dispensacion @relation(fields: [dispensacionId], references: [id], onDelete: Cascade)

  detalleFormulacion DetalleFormulacion @relation(fields: [detalleFormulacionId], references: [id])

  lote LoteInventario @relation(fields: [loteId], references: [id])

  @@unique([dispensacionId, detalleFormulacionId, loteId])
  @@index([detalleFormulacionId])
  @@index([loteId])
  @@map("detalles_dispensacion")
}

model RecuperacionPassword {
  id               Int      @id @default(autoincrement())
  usuarioId        Int
  codigoHash       String
  fechaExpiracion  DateTime
  intentosFallidos Int      @default(0)
  utilizado        Boolean  @default(false)
  createdAt        DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, createdAt])
  @@map("recuperaciones_password")
}

model ReevaluacionTecnicaRecepcion {
  id                     Int @id @default(autoincrement())
  detalleActaRecepcionId Int
  responsableId          Int

  resultadoAnterior ResultadoVerificacionIngreso
  resultadoNuevo    ResultadoVerificacionIngreso

  estadoInvimaAnterior EstadoVerificacionInvima
  estadoInvimaNuevo    EstadoVerificacionInvima

  motivo        String
  referencia    String
  observaciones String?

  tipoCambio TipoCambioVerificacionRecepcion @default(REEVALUACION)

  temperaturaAnterior     Float?
  temperaturaNueva        Float?
  humedadAnterior         Float?
  humedadNueva            Float?
  observacionesAnteriores String?
  observacionesNuevas     String?

  fechaReevaluacion DateTime @default(now())

  detalleActaRecepcion DetalleActaRecepcion @relation(fields: [detalleActaRecepcionId], references: [id])
  responsable          Usuario              @relation(fields: [responsableId], references: [id])

  @@index([detalleActaRecepcionId])
  @@index([responsableId])
  @@map("reevaluaciones_tecnicas_recepcion")
}

model CorreccionDetalleRecepcion {
  id                     Int @id @default(autoincrement())
  detalleActaRecepcionId Int
  responsableId          Int

  numeroLoteAnterior String
  numeroLoteNuevo    String

  fechaVencimientoAnterior DateTime
  fechaVencimientoNueva    DateTime

  cantidadRecibidaAnterior Int
  cantidadRecibidaNueva    Int

  motivo     String
  referencia String

  fechaCorreccion DateTime @default(now())

  detalleActaRecepcion DetalleActaRecepcion                  @relation(fields: [detalleActaRecepcionId], references: [id])
  responsable          Usuario                               @relation(fields: [responsableId], references: [id])
  documentos           DocumentoCorreccionDetalleRecepcion[]

  @@index([detalleActaRecepcionId])
  @@index([responsableId])
  @@map("correcciones_detalle_recepcion")
}

model DocumentoDispensacion {
  id                  Int                   @id @default(autoincrement())
  dispensacionId      Int
  proposito           String                @db.VarChar(32)
  claveAlmacenamiento String                @unique @db.VarChar(80)
  sha256              String                @db.Char(64)
  mime                String                @db.VarChar(64)
  tamano              Int
  creadoAt            DateTime              @default(now())
  creadoPorId         Int
  versionPlantilla    String?               @db.VarChar(32)
  dispensacion        Dispensacion          @relation(fields: [dispensacionId], references: [id], onDelete: Restrict)
  creadoPor           Usuario               @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  bases               SoporteDispensacion[] @relation("DocumentoBase")
  firmados            SoporteDispensacion[] @relation("DocumentoFirmado")
  firmas              SoporteDispensacion[] @relation("ImagenFirma")

  @@index([dispensacionId, proposito])
  @@map("documentos_dispensacion")
}

model SoporteDispensacion {
  id                      Int                    @id @default(autoincrement())
  dispensacionId          Int
  version                 Int
  modalidad               TipoFirmaDispensacion
  tipoReceptor            String                 @db.VarChar(32)
  nombreReceptor          String
  tipoDocumentoReceptor   String                 @db.VarChar(32)
  numeroDocumentoReceptor String
  relacionReceptor        String?
  constanciaAutorizacion  String?                @db.Text
  fechaFirma              DateTime
  registradoAt            DateTime               @default(now())
  registradoPorId         Int
  motivoCorreccion        String?                @db.Text
  documentoBaseId         Int
  documentoFirmadoId      Int                    @unique
  imagenFirmaId           Int?                   @unique
  dispensacion            Dispensacion           @relation(fields: [dispensacionId], references: [id], onDelete: Restrict)
  registradoPor           Usuario                @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)
  documentoBase           DocumentoDispensacion  @relation("DocumentoBase", fields: [documentoBaseId], references: [id], onDelete: Restrict)
  documentoFirmado        DocumentoDispensacion  @relation("DocumentoFirmado", fields: [documentoFirmadoId], references: [id], onDelete: Restrict)
  imagenFirma             DocumentoDispensacion? @relation("ImagenFirma", fields: [imagenFirmaId], references: [id], onDelete: Restrict)

  @@unique([dispensacionId, version])
  @@map("soportes_dispensacion")
}
